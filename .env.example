# Copy to .env (gitignored) and fill in. Never commit real keys.
# If a key is ever committed or shared, rotate it in the Supabase dashboard.

# --- Supabase (optional: without these the server uses data/db.json) ---
# Project Settings -> Data API / API Keys. Create the project in the
# Southeast Asia (Singapore) region. Use the SECRET key (sb_secret_...,
# or the legacy service_role key): it is only ever used by the Node
# server. The publishable/anon key will not work and must never be used here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Gemini (optional: AI drafting, OCR, short-answer grading) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Set GEMINI_FALLBACK_MODEL= to disable model fallback.
# Limits below are shared across models, courses, authoring, OCR and grading.
# They may be reduced, never raised above these free-tier ceilings.
# GEMINI_RPM=15
# GEMINI_TPM=250000
# GEMINI_RPD=500
# Per-request timeout in ms. Default 60000 (60s). Bump to 90000-120000 if
# the model times out on large batches; the API uses AbortSignal.timeout().
# GEMINI_TIMEOUT_MS=60000
# Keep this ledger on persistent disk; do not reset it to bypass limits.
# GEMINI_USAGE_FILE=data/gemini-usage.json
# Billing is controlled by the API key's Google project. Keep that project on
# the free tier in AI Studio; this client cannot inspect or change billing.

# --- NVIDIA (optional: hero-lab DeepSeek 4.1 Flash endpoint) ---
NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# --- Server ---
# PORT=3000
# Time zone for daily limits (coins, resources, trades, AI drafting) and
# participation weeks. Defaults to Asia/Singapore.
# APP_TIMEZONE=Asia/Singapore
