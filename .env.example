# Copy to .env (gitignored) and fill in. Never commit real keys.
# If a key is ever committed or shared, rotate it in the Supabase dashboard.

# --- Supabase (optional: without these the server uses data/db.json) ---
# Project Settings -> Data API / API Keys. Create the project in the
# Southeast Asia (Singapore) region. Use the SECRET key (sb_secret_...,
# or the legacy service_role key): it is only ever used by the Node
# server. The publishable/anon key will not work and must never be used here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Gemini (optional: AI drafting, OCR, short-answer grading) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- NVIDIA (optional: hero-lab DeepSeek 4.1 Flash endpoint) ---
NVIDIA_API_KEY=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# --- Server ---
# PORT=3000
# Time zone for daily limits (coins, resources, trades, AI drafting) and
# participation weeks. Defaults to Asia/Singapore.
# APP_TIMEZONE=Asia/Singapore
